# Fitcheck India — environment variables
# Local: put this file at the project ROOT as `.env` (auto-loaded by server scripts)
# Vercel: add these in Project Settings → Environment Variables

# ── Database ──────────────────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string (URI)
# Prefer the Transaction pooler URL (port 6543) for serverless/IPv4 friendliness:
#   postgresql://postgres.YOUR_REF@aws-0-XX-XX-XX.pooler.supabase.co:6543/postgres
# Leave EMPTY for local development — the server falls back to file-based SQLite.
DATABASE_URL=

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a long random string (https://generate-secret.vercel.app/32)
JWT_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Local dev default: http://localhost:5173  (on Vercel, *.vercel.app is allowed automatically)
CLIENT_ORIGIN=
